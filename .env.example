# Personal Child Context Agent — configuration sample.
# Copy to `.env` and fill real values locally. NEVER commit real secrets.

# --- Gemini via Vertex AI (no API key needed; uses Application Default Credentials) ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
PCCA_MODEL=gemini-2.5-flash

# --- Firestore (persistent source of truth; provisioned in SOT-2739) ---
# Uses ADC / GOOGLE_CLOUD_PROJECT above. Optional emulator for local dev:
# FIRESTORE_EMULATOR_HOST=localhost:8080
FIRESTORE_DATABASE=(default)

# --- Backend selection: "memory" (default, no auth) or "firestore" ---
PCCA_PERSISTENCE=memory

# --- Google Calendar / Gmail (Action Tools; wired in SOT-2742) ---
# Draft-only for Gmail; never auto-sends.
# GOOGLE_CALENDAR_ID=primary
