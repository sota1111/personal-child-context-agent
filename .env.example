# Personal Child Context Agent — configuration sample.
# Copy to `.env` and fill real values locally. NEVER commit real secrets.

# --- Gemini via Vertex AI (no API key needed; uses Application Default Credentials) ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
PCCA_MODEL=gemini-2.5-flash

# --- Firestore (persistent source of truth; provisioned in SOT-2739) ---
# Uses ADC / GOOGLE_CLOUD_PROJECT above. Optional emulator for local dev:
# FIRESTORE_EMULATOR_HOST=localhost:8080
FIRESTORE_DATABASE=(default)

# --- Backend selection: "memory" (default, no auth) or "firestore" ---
PCCA_PERSISTENCE=memory

# --- Google Calendar / Gmail (Action Tools; real executor in SOT-2799) ---
# Executor selection: "mock" (default, offline, no external side effect) or
# "google"/"real" to perform real Calendar / Gmail-draft / Tasks calls via ADC.
# The default stays mock so nothing touches the outside world without opt-in.
PCCA_ACTION_EXECUTOR=mock
# Which resources the real executor writes to (used only when action_executor=google):
# PCCA_GOOGLE_CALENDAR_ID=primary
# PCCA_GMAIL_USER_ID=me
# PCCA_GOOGLE_TASK_LIST_ID=@default
# Optional default "To" for Gmail drafts (still draft-only; never auto-sends):
# PCCA_GMAIL_RECIPIENT=school@example.com

# --- Serving layer (FastAPI backend / Cloud Run; SOT-2794) ---
# Session-cookie auth (server-side HMAC). Generate a strong random AUTH_SECRET:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# In production these come from Secret Manager (see scripts/deploy_cloudrun.sh), not .env.
AUTH_SECRET=change-me-to-a-long-random-string
# Comma-separated allow-list of emails permitted to sign in.
ALLOWED_USER_EMAILS=you@example.com
# Firebase Web API key for server-side email/password verification (Identity Toolkit REST).
# FIREBASE_API_KEY=your-firebase-web-api-key
# Session lifetime in seconds (default 7 days).
# SESSION_MAX_AGE_SECONDS=604800
# "production" makes the session cookie Secure (HTTPS-only); anything else = local dev.
APP_ENV=local
# Allowed CORS origins (comma-separated). '*' is rejected (incompatible with credentials).
CORS_ORIGINS=http://localhost:5173
