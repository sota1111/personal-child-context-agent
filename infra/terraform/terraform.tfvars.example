# Example variable overrides for the PCCA infra stack (SOT-2803).
# Copy to terraform.tfvars and adjust. Secret VALUES are never set here — they are
# provisioned out-of-band (see README "Secret values").

project_id      = "gen-lang-client-0243034020"
region          = "asia-northeast1"
vertex_location = "us-central1"

service_name       = "personal-child-context-agent-backend"
firestore_database = "pcca"

# Point at the image tag/digest the live revision currently runs (see README import).
# container_image = "gcr.io/gen-lang-client-0243034020/personal-child-context-agent-backend:latest"

# Scale / concurrency (defaults shown).
# min_instances = 0
# max_instances = 4
# concurrency   = 80
# cpu           = "1"
# memory        = "512Mi"

# Optional CORS allow-list (empty = env var omitted).
# cors_origins = "https://your-frontend.example.com"

# --- Keyless CI/CD deploy (WIF, SOT-2802) -----------------------------------
# The GitHub repo allowed to federate; must match owner/repo exactly.
github_repository = "sota1111/personal-child-context-agent"
# WIF / deploy SA identifiers (defaults shown).
# deploy_service_account_id = "pcca-github-deployer"
# wif_pool_id               = "github-actions"
# wif_provider_id           = "github-oidc"
